#!/system/bin/sh
# Soften BBK modem SSR so wlan_process grace-timer crashes do not panic the SoC.
level=$(getprop persist.vendor.ssr.restart_level)
[ -z "$level" ] && level=RELATED
for s in /sys/bus/msm_subsys/devices/*/restart_level; do
  echo "$level" > "$s" 2>/dev/null
done
echo 1 > /sys/module/subsystem_restart/parameters/disable_restart_work 2>/dev/null
echo 100 > /sys/module/subsystem_restart/parameters/max_restarts 2>/dev/null
echo 3600000 > /sys/module/subsystem_restart/parameters/max_history_time 2>/dev/null
echo 0 > /sys/module/pil_msa/parameters/modem_trigger_panic 2>/dev/null
exit 0
